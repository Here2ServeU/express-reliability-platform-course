{
  "title": "Reliability Platform — Golden Signals",
  "uid": "rp-golden-signals",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Latency — p95 request duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(flask_api_request_latency_seconds_bucket[5m]))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "id": 2,
      "title": "Traffic — requests per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(flask_api_requests_total[5m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors — 5xx rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(flask_api_requests_total{status=~\"5..\"}[5m])) / sum(rate(flask_api_requests_total[5m]))",
          "legendFormat": "5xx error rate"
        }
      ]
    },
    {
      "id": 4,
      "title": "Saturation — process CPU + memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"flask-api\"}[5m])",
          "legendFormat": "CPU seconds/sec"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"flask-api\"}",
          "legendFormat": "resident memory (bytes)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Service up/down",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "expr": "up{job=\"flask-api\"}", "legendFormat": "flask-api" }
      ]
    }
  ]
}
